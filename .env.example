# Скопируйте в .env.local и заполните. Секреты НЕ коммитить.

# --- Режим ---
# true = AI всегда отвечает mock-данными из /config/mocks (демо без интернета)
DEMO_MODE=true

# --- AI ---
# anthropic | gemini | mock
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=45000
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ТОЛЬКО сервер. Никогда не в NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# --- Админка ---
ADMIN_PASSWORD=change-me

# --- Публичный URL (для шаринга) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
