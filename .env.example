# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Free tier) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service-role key — SERVER ONLY (checkout writes, admin metrics, events). Never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# --- AI: extraction only (school calendars, receipts). Money numbers come from lib/engine ---
# gemini (free key from aistudio.google.com) | anthropic (paid; also requires ALLOW_PAID_AI=true)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_TIMEOUT_MS=30000
# Optional paid provider, disabled unless explicitly allowed
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
ALLOW_PAID_AI=false

# --- Admin metrics page (/admin) ---
ADMIN_PASSWORD=change-me
